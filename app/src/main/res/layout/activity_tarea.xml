<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainTarea"
    android:background="@color/celeste"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="15dp"
    tools:context=".TareaActivity"
    >

    <TextView
        android:id="@+id/tareaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/agregando_tarea"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mainTarea"
        />
    <TextView
        android:id="@+id/linea1"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        app:layout_constraintTop_toBottomOf="@+id/tareaText"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@color/plomo_oscuro"
        />
    <androidx.cardview.widget.CardView
        android:id="@+id/caja_agregar_tareas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linea1"
        app:cardCornerRadius="20dp"
        android:layout_marginTop="15dp"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/caja_tareas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="10dp"
            android:background="@color/verde_oscuro"
            >
            <androidx.cardview.widget.CardView
                android:id="@+id/caja_agregar_tareas_titulo"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                app:layout_constraintStart_toStartOf="@id/caja_tareas"
                app:layout_constraintEnd_toEndOf="@id/caja_tareas"
                app:layout_constraintTop_toTopOf="@id/caja_tareas"
                app:cardCornerRadius="10dp"
                android:layout_marginTop="5dp"
                >
                <EditText
                    android:id="@+id/editTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textColorHint="@color/plomo"
                    android:hint="@string/agregar_titulo_tarea"
                    android:gravity="center"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    android:background="@color/verde_claro_sergio"
                    />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/caja_agregar_tareas_descripcion"
                android:layout_width="match_parent" 
                android:layout_height="30dp"
                app:layout_constraintStart_toStartOf="@id/caja_tareas"
                app:layout_constraintEnd_toEndOf="@id/caja_tareas"
                app:layout_constraintTop_toBottomOf="@id/caja_agregar_tareas_titulo"
                app:cardCornerRadius="10dp"
                android:layout_marginTop="10dp"
                >
                <EditText
                    android:id="@+id/edit_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textColorHint="@color/plomo"
                    android:hint="@string/agregar_descripcion_tarea"
                    android:gravity="center"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    android:background="@color/verde_claro_sergio"
                    />
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:id="@+id/tiempoYhora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="@id/caja_tareas"
                app:layout_constraintTop_toBottomOf="@id/caja_agregar_tareas_descripcion"
                android:layout_marginTop="10dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textSize="20sp"
                    android:layout_marginStart="20dp"
                    android:text="@string/tiempo_limite"
                    android:textColor="@color/white"
                    />
                <androidx.cardview.widget.CardView
                    android:id="@+id/caja_agregar_tareas_hora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    app:cardCornerRadius="10dp"
                    >
                    <EditText
                        android:id="@+id/edit_tiempo_limite"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textColorHint="@color/plomo"
                        android:hint="@string/agregar_hora_tarea"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:background="@color/verde_claro_sergio"
                        />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <TextView
                android:id="@+id/titulo_etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textSize="20sp"
                android:text="@string/texto_eqtiquetas"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="@id/caja_tareas"
                app:layout_constraintEnd_toEndOf="@id/caja_tareas"
                app:layout_constraintTop_toBottomOf="@id/tiempoYhora"
                android:layout_marginTop="40dp"
                />
            <Button
                android:id="@+id/button_agregar_etiqueta"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="10dp"
                android:text="@string/texto_plus"
                android:textColor="@color/white"
                android:textSize="35sp"
                android:backgroundTint="@color/azul_oscuro"
                app:layout_constraintEnd_toEndOf="@id/caja_tareas"
                app:layout_constraintStart_toStartOf="@id/caja_tareas"
                app:layout_constraintTop_toBottomOf="@id/titulo_etiqueta"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <Button
        android:id="@+id/button_guardar_tarea"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:text="@string/texto_guardar"
        android:textColor="@color/white"
        android:backgroundTint="@color/azul_oscuro"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="@id/caja_agregar_tareas"
        app:layout_constraintEnd_toEndOf="@id/caja_agregar_tareas"
        app:layout_constraintTop_toBottomOf="@id/caja_agregar_tareas"
        />
</androidx.constraintlayout.widget.ConstraintLayout>