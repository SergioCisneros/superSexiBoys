<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/celeste"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="vertical">


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#11676a"
                />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="5dp"
            android:text="@string/agregar_meta"
            android:textAlignment="center"
            android:textColor="@android:color/black"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                app:cardCornerRadius="12dp"
                android:backgroundTint="#11676a">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#4DD0B5"
                        app:cardCornerRadius="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:orientation="vertical"
                            android:padding="8dp"
                            >

                            <EditText
                                android:id="@+id/titulo_meta"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:textColor="@color/white"
                                android:hint="@string/titulo_meta"
                                android:textColorHint="#d8e4ff" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>


                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#2339A8"
                        app:cardCornerRadius="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:orientation="vertical"
                            android:padding="8dp"
                            >

                            <EditText
                                android:id="@+id/descripcion_meta"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:hint="@string/descripcion_meta"
                                android:textColor="@color/white"
                                android:textColorHint="#d8e4ff"
                                />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>



                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/fecha_inicio1"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#4DD0B5"
                        app:cardCornerRadius="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:orientation="vertical"
                            android:padding="8dp"
                            >

                            <EditText
                                android:id="@+id/fechaInMeta"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:hint="@string/fecha_inicio_meta"
                                android:textColor="@color/white"
                                android:textColorHint="#d8e4ff"
                                />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/fecha_limite1"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#4DD0B5"
                        app:cardCornerRadius="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:orientation="vertical"
                            android:padding="8dp"
                            >

                            <EditText
                                android:id="@+id/fechaLiMeta"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:hint="@string/fecha_limite_meta"
                                android:textColor="@color/white"
                                android:textColorHint="#d8e4ff"
                                />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>




                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/etiqueta1"
                        android:textColor="@android:color/white"
                        android:layout_gravity="center"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#4DD0B5"
                        app:cardCornerRadius="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"

                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:orientation="vertical"
                            android:padding="8dp"

                            >

                            <EditText
                                android:id="@+id/etiquetaNueva"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:hint="Etiqueta"
                                android:textColorHint="#d8e4ff"
                                android:textColor="@color/white"
                                />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/actividades1"
                        android:textColor="@android:color/white"
                        android:layout_gravity="center"
                        android:textStyle="bold" />


                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#4DD0B5"
                        app:cardCornerRadius="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        >

                        <LinearLayout
                            android:id="@+id/layoutActividades"
                            android:layout_width="364dp"
                            android:layout_height="41dp"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <EditText
                                android:id="@+id/actividadNueva"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:hint="@string/texto_metas_actividades"
                                android:textColor="@color/white"
                                android:textColorHint="#d8e4ff" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <Button
                        android:id="@+id/btnAgregarActividad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:backgroundTint="#2339A8"
                        android:text="@string/botonplus"
                        android:textColor="@android:color/white" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>




        </LinearLayout>




    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="200dp"
            android:layout_height="45dp"
            android:text="@string/btnGuardarMeta"
            android:backgroundTint="#1800ad"
            android:textColor="@android:color/white"/>
    </LinearLayout>

</LinearLayout>
