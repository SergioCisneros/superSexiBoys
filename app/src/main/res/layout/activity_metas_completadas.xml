<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MetasCompletadasActivity"
    android:orientation="vertical"
    android:background="@color/celeste"
    >

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tituloMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/metas_completadas"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="#11676a"
            android:layout_gravity="center"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:background="#11676A"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- RecyclerView para mostrar metas completadas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMetasCompletadas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>
</LinearLayout>
