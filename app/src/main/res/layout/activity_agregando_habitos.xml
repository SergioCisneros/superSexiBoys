<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/celeste"
    tools:context=".HabitosActivity">
    <LinearLayout
        android:id="@+id/identifica_usuario"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:weightSum="10"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_margin="15dp"
        android:layout_height="wrap_content">
        <Button
            android:layout_weight="8"
            android:layout_width="0dp"
            android:text="Ver perfil"
            android:backgroundTint="@color/verde_oscuro"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/imagen_perfil"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="40dp"
            android:src="@drawable/perfilvacio"/>
    </LinearLayout>

    <TextView
        android:id="@+id/agrega_habito_text"
        app:layout_constraintTop_toBottomOf="@+id/identifica_usuario"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="AGREGANDO HÁBITO"
        android:textSize="25sp"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/linea"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/agrega_habito_text"
        android:background="@color/plomo_oscuro"/>
    <androidx.cardview.widget.CardView
        app:layout_constraintBottom_toTopOf="@+id/guardar_habito"
        app:layout_constraintTop_toBottomOf="@+id/linea"
        android:layout_width="match_parent"
        android:layout_margin="15dp"
        app:cardCornerRadius="10dp"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="5dp"
            android:layout_width="match_parent"
            android:background="@color/verde_oscuro"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/titulo"
                android:layout_width="match_parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:cardCornerRadius="10dp"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">
                    <EditText
                        android:background="@color/verde_claro"
                        android:hint="Título"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <androidx.cardview.widget.CardView
                android:id="@+id/descripcion"
                android:layout_width="match_parent"
                app:layout_constraintTop_toBottomOf="@+id/titulo"
                app:cardCornerRadius="10dp"
                android:layout_margin="10dp"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">
                    <EditText
                        android:background="@color/verde_claro"
                        android:hint="Descripción"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/text_fecha"
                app:layout_constraintTop_toBottomOf="@+id/descripcion"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:text="Fecha de inicio:"/>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/descripcion"
                app:layout_constraintStart_toEndOf="@+id/text_fecha"
                app:cardCornerRadius="10dp"
                android:layout_margin="5dp"

                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <EditText

                        android:background="@color/verde_claro"
                        android:hint="dd/mm/aaaa"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/horario"
                app:layout_constraintTop_toBottomOf="@+id/text_fecha"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="wrap_content"
                android:textColor="@color/white"
                android:layout_height="wrap_content"
                android:text="Horario"
                android:textSize="25sp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/bloque_horario"
                app:layout_constraintTop_toBottomOf="@+id/horario"
                android:layout_width="match_parent"
                android:background="@color/azul_oscuro"
                app:cardCornerRadius="10dp"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:background="@color/azul_oscuro"
                    android:padding="5dp"
                    android:layout_height="wrap_content">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:id="@+id/dia"
                        app:cardCornerRadius="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">
                            <EditText
                                android:id="@+id/dia_elegido"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:background="@color/celeste"
                                android:hint="Día"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        app:layout_constraintTop_toBottomOf="@+id/dia"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_width="match_parent"
                        android:layout_margin="5dp"
                        app:cardCornerRadius="10dp"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">
                            <EditText
                                android:id="@+id/hora_elegida"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/celeste"
                                android:gravity="center"
                                android:hint="Hora"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <Button
                android:id="@+id/agregar_horario_button"
                app:layout_constraintTop_toBottomOf="@+id/bloque_horario"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="wrap_content"
                android:text="Agregar horario"
                android:backgroundTint="@color/azul_oscuro"
                android:layout_height="wrap_content"/>
            <androidx.recyclerview.widget.RecyclerView
                app:layout_constraintTop_toBottomOf="@+id/agregar_horario_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/recycler_horarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/nombre_etiqueta"
                app:layout_constraintTop_toBottomOf="@+id/recycler_horarios"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="wrap_content"
                android:textColor="@color/white"
                android:layout_height="wrap_content"
                android:text="Etiquetas"
                android:textSize="25sp"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/nombre_etiqueta_edit_text"
                android:layout_width="match_parent"
                app:cardCornerRadius="10dp"
                app:layout_constraintTop_toBottomOf="@+id/nombre_etiqueta"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"

                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/nombre_de_etiqueta"
                        android:layout_width="match_parent"
                        android:hint="Nombre de etiqueta"
                        android:gravity="center"
                        android:background="@color/celeste"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.recyclerview.widget.RecyclerView
                app:layout_constraintTop_toBottomOf="@+id/agregar_etiqueta_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/recycler_etiquetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/agregar_etiqueta_button"
                app:layout_constraintTop_toBottomOf="@+id/nombre_etiqueta_edit_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="wrap_content"
                android:text="Agregar etiqueta"
                android:backgroundTint="@color/azul_oscuro"
                android:layout_height="wrap_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/guardar_habito"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:text="Guardar"
        android:layout_margin="15dp"
        android:backgroundTint="@color/azul_oscuro"
        android:layout_height="wrap_content"/>


</androidx.constraintlayout.widget.ConstraintLayout>