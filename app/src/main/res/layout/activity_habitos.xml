<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/celeste"
    tools:context=".HabitosActivity">
    <androidx.cardview.widget.CardView
        android:id="@+id/identifica_usuario"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_margin="15dp"
        app:cardCornerRadius="10dp"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="5dp"
            android:layout_width="match_parent"
            android:background="@color/verde_oscuro"
            android:layout_height="wrap_content">
            <TextView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="NOMBRE USUARIO"
                android:layout_width="wrap_content"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:layout_height="wrap_content" />
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/perfilvacio"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <Button
        app:layout_constraintTop_toBottomOf="@+id/identifica_usuario"
        app:layout_constraintEnd_toStartOf="@+id/metas_button"
        android:layout_width="wrap_content"
        android:text="HÁBITOS"
        android:layout_margin="15dp"
        android:backgroundTint="@color/azul_oscuro"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/metas_button"
        app:layout_constraintTop_toBottomOf="@+id/identifica_usuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:text="METAS"
        android:layout_margin="15dp"
        android:backgroundTint="@color/azul_pastel"
        android:layout_height="wrap_content"/>
    <Button
        app:layout_constraintTop_toBottomOf="@+id/identifica_usuario"
        app:layout_constraintStart_toEndOf="@id/metas_button"
        android:layout_width="wrap_content"
        android:text="TAREAS"
        android:layout_margin="15dp"
        android:backgroundTint="@color/azul_pastel"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/linea"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/metas_button"
        android:background="@color/plomo_oscuro"/>

    <Button
        android:id="@+id/agregar_habito"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:text="Nuevo Hábito"
        android:layout_margin="15dp"
        android:backgroundTint="@color/azul_oscuro"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/comunidades"
        app:layout_constraintBottom_toTopOf="@+id/agregar_habito"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:text="Comunidades"
        android:layout_margin="15dp"
        android:backgroundTint="@color/azul_oscuro"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/linea2"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/comunidades"
        android:background="@color/plomo_oscuro"/>
</androidx.constraintlayout.widget.ConstraintLayout>