<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/celeste"
    tools:context=".HabitosActivity">
    <LinearLayout
        android:id="@+id/identifica_usuario"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:weightSum="10"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_margin="15dp"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/ver_perfil_button"
            android:layout_weight="8"
            android:layout_width="0dp"
            android:text="@string/ver_perfil"
            android:backgroundTint="@color/verde_oscuro"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/imagen_perfil"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="40dp"
            android:src="@drawable/perfilvacio"/>
    </LinearLayout>


    <Button
        app:layout_constraintTop_toBottomOf="@+id/identifica_usuario"
        app:layout_constraintEnd_toStartOf="@+id/metas_button"
        android:layout_width="wrap_content"
        android:text="@string/habitos"
        android:layout_margin="15dp"
        android:backgroundTint="@color/azul_oscuro"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/metas_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/azul_pastel"
        android:text="@string/metas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/identifica_usuario" />

    <Button
        android:id="@+id/tareas_button"
        app:layout_constraintTop_toBottomOf="@+id/identifica_usuario"
        app:layout_constraintStart_toEndOf="@id/metas_button"
        android:layout_width="wrap_content"
        android:text="@string/tareas"
        android:layout_margin="15dp"
        android:backgroundTint="@color/azul_pastel"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/linea"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/metas_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/plomo_oscuro"/>
    
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_habitos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/linea"
        app:layout_constraintBottom_toTopOf="@+id/linea2"/>

    <Button
        android:id="@+id/nuevo_habito_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:text="@string/nuevo_habito"
        android:layout_margin="15dp"
        android:backgroundTint="@color/azul_oscuro"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/comunidades_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/azul_oscuro"
        android:text="@string/comunidades"
        app:layout_constraintBottom_toTopOf="@+id/nuevo_habito_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/linea2"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/comunidades_button"
        android:background="@color/plomo_oscuro"/>
</androidx.constraintlayout.widget.ConstraintLayout>