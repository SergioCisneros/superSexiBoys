<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/celeste"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="15dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/logintext"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:text="@string/inicio_de_sesion"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/linea"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/logintext"
        android:background="@color/plomo_oscuro"/>

    <androidx.cardview.widget.CardView
        android:layout_marginTop="20dp"
        android:id="@+id/logoApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/linea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="68dp">
        <LinearLayout
            android:layout_width="271dp"
            android:gravity="center"
            android:background="@color/celeste"
            android:layout_height="271dp">
            <ImageView
                android:layout_width="273dp"
                android:layout_height="273dp"
                android:src="@drawable/logollama" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    
    <androidx.cardview.widget.CardView
        android:id="@+id/loginUsuario"
        android:layout_width="match_parent"
        android:layout_margin="30dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/logoApp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="10dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde_oscuro">
            <EditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:textColorHint="@color/plomo"
                android:hint="@string/e_mail"
                android:gravity="center"
                android:textColor="@color/white"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/login_contrasena"
        android:layout_width="match_parent"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/loginUsuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="10dp"
        android:layout_margin="30dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde_oscuro">
            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:hint="@string/contrasenia"
                android:gravity="center"
                android:textColorHint="@color/plomo"
                android:textColor="@color/white"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <Button
        android:id="@+id/loginButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/login"
        android:backgroundTint="@color/azul_oscuro"
        android:layout_margin="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_contrasena"/>
    <Button
        android:id="@+id/registroButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/registrarse"
        android:backgroundTint="@color/azul_oscuro"
        android:layout_margin="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toTopOf="@+id/registroButton"
        android:background="@color/plomo_oscuro"/>
</androidx.constraintlayout.widget.ConstraintLayout>