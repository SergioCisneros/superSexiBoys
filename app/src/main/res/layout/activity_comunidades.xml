<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/celeste"
    tools:context=".HabitosActivity">


    <TextView
        android:id="@+id/comunidades_text"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/comunidades"
        android:textSize="25sp"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/linea"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/comunidades_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/plomo_oscuro"/>

    <TextView
        android:id="@+id/habitos_text"
        app:layout_constraintTop_toBottomOf="@+id/linea"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/habitos"
        android:textSize="20sp"
        android:layout_height="wrap_content"/>

    <androidx.cardview.widget.CardView
        app:layout_constraintTop_toBottomOf="@+id/habitos_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:cardCornerRadius="10dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:background="@color/verde_oscuro"
            android:padding="10dp"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/text_titulo"
                android:textColor="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="match_parent"
                android:text="@string/leer_todos_los_dias"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:textSize="20sp"/>
            <TextView
                android:id="@+id/text_descripcion"
                app:layout_constraintTop_toBottomOf="@+id/text_titulo"
                android:layout_width="match_parent"
                android:textColor="@color/white"
                android:layout_height="wrap_content"
                android:textSize="15sp"/>
            <Button
                android:id="@+id/button_empieza"
                app:layout_constraintTop_toBottomOf="@+id/text_descripcion"
                app:layout_constraintStart_toStartOf="parent"
                android:backgroundTint="@color/azul_oscuro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empezar_habito"/>
            <TextView
                android:id="@+id/text_contador"
                app:layout_constraintTop_toTopOf="@+id/button_empieza"
                app:layout_constraintBottom_toBottomOf="@+id/button_contador"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rep_1"
                android:textColor="@color/white"
                android:textSize="25sp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/primer"
                app:layout_constraintStart_toEndOf="@+id/text_contador"
                app:layout_constraintBottom_toBottomOf="@+id/text_contador"
                app:layout_constraintTop_toTopOf="@+id/text_contador"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardCornerRadius="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="#7EADDD"
                    android:padding="5dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/text_view_adapter_etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:text="@string/upb"
                        android:textColor="@color/black"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>



</androidx.constraintlayout.widget.ConstraintLayout>